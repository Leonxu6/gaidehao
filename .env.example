# ScholAI - Probabilistic layer text regeneration
# Copy this file to .env and fill in your values.
# All variables are optional unless marked required.

# ─── Required ────────────────────────────────────────────────────────────────
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# ─── LLM Configuration ────────────────────────────────────────────────────────
# Model identifier (DeepSeek API models only)
# DEEPSEEK_MODEL=deepseek-chat

# ─── Embedding Configuration ─────────────────────────────────────────────────
# BGE-M3 model name (default: BAAI/bge-m3)
# EMBEDDING_MODEL=BAAI/bge-m3
# Device for embedding model: cpu (default) or cuda
# DEVICE=cpu
# Batch size for embedding encoding (default: 32)
# EMBEDDING_BATCH_SIZE=32

# ─── Pipeline Defaults ────────────────────────────────────────────────────────
# Maximum rewrite attempts inside RetryOrchestrator (default: 3)
# MAX_RETRIES=3
# Minimum cosine similarity for layer-1 semantic check (default: 0.80)
# SIMILARITY_THRESHOLD=0.80
# Minimum G-Eval overall score accepted without warning (default: 3.0)
# MIN_QUALITY_SCORE=3.0
